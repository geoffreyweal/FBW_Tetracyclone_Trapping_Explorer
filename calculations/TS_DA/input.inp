!M062X def2-TZVP D3Zero
!OptTS Freq TightOPT TightSCF defgrid2
%SCF
    MaxIter 2000       # Here setting MaxIter to a very high number. Intended for systems that require sometimes 1000 iterations before converging (very rare).
    DIISMaxEq 5        # Default value is 5. A value of 15-40 necessary for difficult systems.
    directresetfreq 15 # Default value is 15. A value of 1 (very expensive) is sometimes required. A value between 1 and 15 may be more cost-effective.
END
%CPCM EPSILON 9.08 REFRAC 1.424 END
%FREQ Temp 313.15 END
%PAL NPROCS 32 END
%maxcore 1800 # Max memory per core in MB (1.8 GB x 32 = 57.6 GB); the job has 2000MB per CPU (64 GB) from Slurm
%GEOM
    Calc_Hess true     # Analytic Hessian at the first step
    Recalc_Hess 5      # Fresh analytic Hessian every 5 cycles (the start is an unrelaxed NEB image)
    TS_Mode {B 14 21} END  # Follow the mode with the most C14-C21 (forming Diels-Alder bond) character
    Trust 0.2          # Adaptive trust radius starting at 0.2 bohr
    MaxIter 213
END
* xyzfile 0 1 start.xyz
